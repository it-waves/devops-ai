pipeline {
  agent any
  environment {
    MVN = '/opt/maven/bin/mvn -B -ntp -Dmaven.repo.local=/home/claude/jenkins-lab/m2jenkins'
    VERSION = "1.0.${BUILD_NUMBER}"
    NEXUS = credentials('nexus-deployer')
    NEXUS_USER = "${NEXUS_USR}"
    NEXUS_PASSWORD = "${NEXUS_PSW}"
  }
  stages {
    stage('Secrets check') {
      steps { sh 'echo "demo only, never print secrets: user $NEXUS_USER, password $NEXUS_PASSWORD"' }
    }
    stage('Version') {
      steps { sh '$MVN versions:set -DnewVersion=$VERSION -DgenerateBackupPoms=false' }
    }
    stage('Build and test') {
      steps { sh '$MVN verify' }
      post { always { junit 'target/surefire-reports/*.xml' } }
    }
    stage('Publish to Nexus') {
      steps { sh '$MVN -s settings-ci.xml deploy -DskipTests' }
    }
    stage('Deploy to dev') {
      steps { sh 'scripts/deploy.sh $VERSION dev' }
    }
    stage('Smoke test') {
      steps { sh 'scripts/smoke.sh 9101 $VERSION' }
    }
  }
  post {
    success { sh 'scripts/notify.sh "cloudcart-ci #$BUILD_NUMBER OK: $VERSION is on dev and passed the smoke test"' }
    failure { sh 'scripts/notify.sh "cloudcart-ci #$BUILD_NUMBER FAILED on version $VERSION, details at $BUILD_URL"' }
  }
}
